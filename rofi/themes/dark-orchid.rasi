/* THE TOKENS
 *
 * What the colours above are *for*. Write a launcher in these rather than in
 * the stops and it stays in step when a stop moves: each one points at a stop
 * instead of repeating its value.
 */
* {
    /* Accent — what is lit: the selected row, the prompt, the active mode
       button. Every one of these comes from the one purple ramp, and nothing
       else in a launcher may be purple. */
    accent:             @brand-500;
    on-accent:          @black;
    accent-bright:      @brand-300;       /* deprecated — accent text takes `accent` */
    accent-lit:         @brand-400;
    accent-dim:         @brand-600;
    accent-peak:        @brand-200;
    accent-surface:     @brand-800;

    /* Neutral — the greys the rest of the launcher is built from, stacked
       darkest to lightest. A surface that has to differ from its neighbour
       moves along this ramp rather than into another hue. */
    bg:                 @zinc-950;
    bg-tinted:          @brand-950;
    bg-alt:             @zinc-900;
    surface:            @zinc-800;
    border:             @zinc-700;
    selection-muted:    @zinc-700;
    fg-faint:           @zinc-600;
    fg-muted:           @zinc-500;
    fg:                 @zinc-300;
    fg-strong:          @zinc-100;
    on-cursor:          @zinc-900;

    /* Status — a state an entry or a message has to report. The 600 stops
       are for indicators; where one of these has to be readable running text,
       move up the same ramp to the 300 stop. */
    error:              @red-600;
    warning:            @yellow-600;
    success:            @green-600;
    info:               @blue-600;
    hint:               @zinc-500;
    error-underline:    @red-900;

    /* Depth — one gradient for nesting that has to stay legible. Take the
       stops in order and stop when the interface runs out of levels. */
    depth-1:            @brand-300;
    depth-2:            @violet-400;
    depth-3:            @purple-400;
    depth-4:            @fuchsia-300;
    depth-5:            @pink-300;
    depth-6:            @blue-300;

    /* Overlay — the tokens with an alpha channel, for a window rofi lets you
       make translucent but not transparent, and for a backing that keeps text
       readable over one. These are the only names here that write a value out:
       a reference cannot carry an opacity, because rofi resolves it as a whole
       property and never as a part of one. Eight-digit hex keeps them in the
       one notation every other colour in this file is written in — rofi reads
       `rgba(115, 0, 255, 14%)` just as happily, and dumps either form as the
       same value. */
    overlay-hover:      #7300ff24;         /* accent at 14% */
    overlay-active:     #7300ff3d;         /* accent at 24% */
    scrim:              #09090b8c;         /* bg at 55% */
    scrim-strong:       #09090bcc;         /* bg at 80% */
    bg-translucent:     #09090bd9;         /* bg at 85% */

    /* Syntax — for anything that renders code or markup, which in a launcher
       is rare but costs nothing to have ready. These hues are not accents. */
    syn-comment:        @zinc-500;
    syn-string:         @green-300;
    syn-function:       @blue-300;
    syn-keyword:        @violet-400;
    syn-type:           @cyan-200;
    syn-storage:        @purple-400;
    syn-property:       @fuchsia-300;
    syn-text:           @zinc-300;
    syn-tag:            @pink-300;
    syn-todo:           @blue-400;
    syn-link:           @blue-300;
}
