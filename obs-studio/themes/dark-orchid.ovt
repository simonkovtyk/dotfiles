    --do_green_50: #f0fdf4; /* green-50 */
    --do_green_100: #dcfce7; /* green-100 */
    --do_green_200: #bbf7d0; /* green-200 */
    --do_green_300: #86efac; /* syn-string */
    --do_green_400: #4ade80; /* green-400 */
