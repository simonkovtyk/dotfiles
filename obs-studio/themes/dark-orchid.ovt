    --do_gray_300: #d1d5db; /* gray-300 */
    --do_gray_400: #9ca3af; /* gray-400 */
    --do_gray_500: #6b7280; /* gray-500 */
    --do_gray_600: #4b5563; /* gray-600 */
    --do_gray_700: #374151; /* gray-700 */
    --do_gray_800: #1f2937; /* gray-800 */
