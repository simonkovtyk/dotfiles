    --do_cyan_50: #ecfeff; /* cyan-50 */
    --do_cyan_100: #cffafe; /* cyan-100 */
    --do_cyan_200: #a5f3fc; /* syn-type */
    --do_cyan_300: #67e8f9; /* cyan-300 */
    --do_cyan_400: #22d3ee; /* cyan-400 */
    --do_cyan_500: #06b6d4; /* cyan-500 */
    --do_cyan_600: #0891b2; /* cyan-600 */
    --do_cyan_700: #0e7490; /* cyan-700 */
    --do_cyan_800: #155e75; /* cyan-800 */
    --do_cyan_900: #164e63; /* cyan-900 */
    --do_cyan_950: #083344; /* cyan-950 */

    --do_sky_50: #f0f9ff; /* sky-50 */
    --do_sky_100: #e0f2fe; /* sky-100 */
    --do_sky_200: #bae6fd; /* sky-200 */
    --do_sky_300: #7dd3fc; /* sky-300 */
    --do_sky_400: #38bdf8; /* sky-400 */
    --do_sky_500: #0ea5e9; /* sky-500 */
    --do_sky_600: #0284c7; /* sky-600 */
    --do_sky_700: #0369a1; /* sky-700 */
    --do_sky_800: #075985; /* sky-800 */
    --do_sky_900: #0c4a6e; /* sky-900 */
    --do_sky_950: #082f49; /* sky-950 */

    --do_blue_50: #eff6ff; /* blue-50 */
    --do_blue_100: #dbeafe; /* blue-100 */
    --do_blue_200: #bfdbfe; /* blue-200 */
    --do_blue_300: #93c5fd; /* syn-function, syn-link, depth-6 */
    --do_blue_400: #60a5fa; /* syn-todo */
    --do_blue_500: #3b82f6; /* blue-500 */
    --do_blue_600: #2563eb; /* info */
    --do_blue_700: #1d4ed8; /* blue-700 */
    --do_blue_800: #1e40af; /* blue-800 */
    --do_blue_900: #1e3a8a; /* blue-900 */
    --do_blue_950: #172554; /* blue-950 */

    --do_indigo_50: #eef2ff; /* indigo-50 */
    --do_indigo_100: #e0e7ff; /* indigo-100 */
    --do_indigo_200: #c7d2fe; /* indigo-200 */
    --do_indigo_300: #a5b4fc; /* indigo-300 */
    --do_indigo_400: #818cf8; /* indigo-400 */
    --do_indigo_500: #6366f1; /* indigo-500 */
    --do_indigo_600: #4f46e5; /* indigo-600 */
    --do_indigo_700: #4338ca; /* indigo-700 */
    --do_indigo_800: #3730a3; /* indigo-800 */
    --do_indigo_900: #312e81; /* indigo-900 */
    --do_indigo_950: #1e1b4b; /* indigo-950 */

    --do_violet_50: #f5f3ff; /* violet-50 */
    --do_violet_100: #ede9fe; /* violet-100 */
    --do_violet_200: #ddd6fe; /* violet-200 */
    --do_violet_300: #c4b5fd; /* violet-300 */
    --do_violet_400: #a78bfa; /* syn-keyword, depth-2 */
    --do_violet_500: #8b5cf6; /* violet-500 */
    --do_violet_600: #7c3aed; /* violet-600 */
    --do_violet_700: #6d28d9; /* violet-700 */
    --do_violet_800: #5b21b6; /* violet-800 */
    --do_violet_900: #4c1d95; /* violet-900 */
    --do_violet_950: #2e1065; /* violet-950 */

    --do_purple_50: #faf5ff; /* purple-50 */
    --do_purple_100: #f3e8ff; /* purple-100 */
    --do_purple_200: #e9d5ff; /* purple-200 */
    --do_purple_300: #d8b4fe; /* purple-300 */
    --do_purple_400: #c084fc; /* syn-storage, depth-3 */
    --do_purple_500: #a855f7; /* purple-500 */
    --do_purple_600: #9333ea; /* purple-600 */
    --do_purple_700: #7e22ce; /* purple-700 */
    --do_purple_800: #6b21a8; /* purple-800 */
    --do_purple_900: #581c87; /* purple-900 */
    --do_purple_950: #3b0764; /* purple-950 */

    --do_fuchsia_50: #fdf4ff; /* fuchsia-50 */
    --do_fuchsia_100: #fae8ff; /* fuchsia-100 */
    --do_fuchsia_200: #f5d0fe; /* fuchsia-200 */
    --do_fuchsia_300: #f0abfc; /* syn-property, depth-4 */
    --do_fuchsia_400: #e879f9; /* fuchsia-400 */
    --do_fuchsia_500: #d946ef; /* fuchsia-500 */
    --do_fuchsia_600: #c026d3; /* fuchsia-600 */
    --do_fuchsia_700: #a21caf; /* fuchsia-700 */
    --do_fuchsia_800: #86198f; /* fuchsia-800 */
    --do_fuchsia_900: #701a75; /* fuchsia-900 */
    --do_fuchsia_950: #4a044e; /* fuchsia-950 */

    --do_pink_50: #fdf2f8; /* pink-50 */
    --do_pink_100: #fce7f3; /* pink-100 */
    --do_pink_200: #fbcfe8; /* pink-200 */
    --do_pink_300: #f9a8d4; /* syn-tag, depth-5 */
    --do_pink_400: #f472b6; /* pink-400 */
    --do_pink_500: #ec4899; /* pink-500 */
    --do_pink_600: #db2777; /* pink-600 */
    --do_pink_700: #be185d; /* pink-700 */
    --do_pink_800: #9d174d; /* pink-800 */
    --do_pink_900: #831843; /* pink-900 */
    --do_pink_950: #500724; /* pink-950 */

    --do_rose_50: #fff1f2; /* rose-50 */
    --do_rose_100: #ffe4e6; /* rose-100 */
    --do_rose_200: #fecdd3; /* rose-200 */
    --do_rose_300: #fda4af; /* rose-300 */
    --do_rose_400: #fb7185; /* rose-400 */
    --do_rose_500: #f43f5e; /* rose-500 */
    --do_rose_600: #e11d48; /* rose-600 */
    --do_rose_700: #be123c; /* rose-700 */
    --do_rose_800: #9f1239; /* rose-800 */
    --do_rose_900: #881337; /* rose-900 */
    --do_rose_950: #4c0519; /* rose-950 */

    /* : The roles — what the colors above are for */

    --do_accent: var(--do_brand_500);
    --do_on_accent: var(--do_black);
    --do_accent_lit: var(--do_brand_400);
    --do_accent_dim: var(--do_brand_600);
    --do_accent_peak: var(--do_brand_200);
    --do_accent_surface: var(--do_brand_800);

    --do_bg: var(--do_zinc_950);
    --do_bg_tinted: var(--do_brand_950);
    --do_bg_alt: var(--do_zinc_900);
    --do_surface: var(--do_zinc_800);
    --do_border: var(--do_zinc_700);
    --do_selection_muted: var(--do_zinc_700);
    --do_fg_faint: var(--do_zinc_600);
    --do_fg_muted: var(--do_zinc_500);
    --do_fg: var(--do_zinc_300);
    --do_fg_strong: var(--do_zinc_100);
    --do_on_cursor: var(--do_zinc_900);

    --do_error: var(--do_red_600);
    --do_warning: var(--do_yellow_600);
    --do_success: var(--do_green_600);
    --do_info: var(--do_blue_600);
    --do_hint: var(--do_zinc_500);
    --do_error_underline: var(--do_red_900);

    --do_depth_1: var(--do_brand_300);
    --do_depth_2: var(--do_violet_400);
    --do_depth_3: var(--do_purple_400);
    --do_depth_4: var(--do_fuchsia_300);
    --do_depth_5: var(--do_pink_300);
    --do_depth_6: var(--do_blue_300);

    --do_syn_comment: var(--do_zinc_500);
    --do_syn_string: var(--do_green_300);
    --do_syn_function: var(--do_blue_300);
    --do_syn_keyword: var(--do_violet_400);
    --do_syn_type: var(--do_cyan_200);
    --do_syn_storage: var(--do_purple_400);
    --do_syn_property: var(--do_fuchsia_300);
    --do_syn_text: var(--do_zinc_300);
    --do_syn_tag: var(--do_pink_300);
    --do_syn_todo: var(--do_blue_400);
    --do_syn_link: var(--do_blue_300);

    --do_overlay_hover: rgba(115, 0, 255, 0.14); /* overlay-hover — accent at 14% */
    --do_overlay_active: rgba(115, 0, 255, 0.24); /* overlay-active — accent at 24% */

    /* : The base theme's own names, pointed at the roles above */

    /* Its accent ramp becomes the purple one. */
    --blue1: var(--do_brand_300);
    --blue2: var(--do_accent_lit);
    --blue3: var(--do_accent);
    --blue4: var(--do_accent_dim);
    --blue5: var(--do_brand_700);
    --blue6: var(--do_accent_surface);

    /* Hidden sources are a quiet state, not a hue. */
    --purple1: var(--do_fg_muted);
    --purple2: var(--do_fg_faint);
    --purple3: var(--do_border);
    --purple4: var(--do_border);
    --purple5: var(--do_surface);
    --purple6: var(--do_bg_alt);

    /* Status ramps stay status colors. */
    --red1: var(--do_red_300);
    --red2: var(--do_red_500);
    --red3: var(--do_error);
    --red4: var(--do_red_700);
    --red5: var(--do_red_800);
    --red6: var(--do_red_900);

    --green1: var(--do_green_300);
    --green2: var(--do_green_500);
    --green3: var(--do_success);
    --green4: var(--do_green_700);
    --green5: var(--do_green_800);
    --green6: var(--do_green_900);

    --yellow1: var(--do_yellow_300);
    --yellow2: var(--do_yellow_500);
    --yellow3: var(--do_warning);
    --yellow4: var(--do_yellow_700);
    --yellow5: var(--do_yellow_800);
    --yellow6: var(--do_yellow_900);

    /* Greys, lightest to darkest. */
    --grey1: var(--do_fg_faint);
    --grey2: var(--do_fg_faint);
    --grey3: var(--do_border);
    --grey4: var(--do_border);
    --grey5: var(--do_surface);
    --grey6: var(--do_surface);
    --grey7: var(--do_bg_alt);
    --grey8: var(--do_bg);

    --white1: var(--do_fg_strong);
    --white2: var(--do_zinc_200);
    --white3: var(--do_fg);
    --white4: var(--do_zinc_400);
    --white5: var(--do_fg_muted);

    --black1: var(--do_bg);
    --black2: var(--do_bg_alt);
    --black3: var(--do_border);
    --black4: var(--do_fg_faint);
    --black5: var(--do_fg_muted);

    /* Surfaces and text. */
    --bg_window: var(--do_bg);
    --bg_base: var(--do_bg_alt);
    --bg_preview: var(--do_bg);

    --primary: var(--do_accent);
    --primary_light: var(--do_accent_lit);
    --primary_lighter: var(--do_accent);
    --primary_dark: var(--do_accent_dim);
    --primary_darker: var(--do_accent_surface);

    --warning: var(--do_warning);
    --danger: var(--do_error);

    --text: var(--do_fg);
    --text_light: var(--do_fg_strong);
    --text_muted: var(--do_fg_muted);
    --text_disabled: var(--do_fg_faint);
    --text_inactive: var(--do_fg);

    --highlight_color: var(--do_accent);

    /* Inputs, buttons, lists and tabs. */
    --border_color: var(--do_border);
    --input_bg: var(--do_surface);
    --input_bg_hover: var(--do_surface);
    --input_bg_focus: var(--do_bg_alt);
    --input_border: var(--do_border);
    --input_border_hover: var(--do_fg_faint);
    --input_border_focus: var(--do_accent);

    --list_item_bg_selected: var(--do_accent);
    --list_item_bg_hover: var(--do_overlay_hover);

    --button_bg: var(--do_surface);
    --button_bg_hover: var(--do_border);
    --button_bg_down: var(--do_bg_alt);
    --button_bg_disabled: var(--do_bg_alt);
    --button_border: var(--do_surface);
    --button_border_hover: var(--do_fg_faint);
    --button_border_focus: var(--do_accent);

    --tab_bg: var(--do_bg_alt);
    --tab_bg_hover: var(--do_surface);
    --tab_bg_down: var(--do_accent);
    --tab_bg_disabled: var(--do_bg_alt);
    --tab_border: var(--do_border);
    --tab_border_hover: var(--do_fg_faint);
    --tab_border_focus: var(--do_accent);
    --tab_border_selected: var(--do_accent);

    --separator_hover: var(--do_accent);

    --scrollbar_handle: var(--do_border);
    --scrollbar_bg: var(--do_bg_alt);
    --scrollbar_hover: var(--do_fg_faint);
    --scrollbar_down: var(--do_accent);
    --scrollbar_border: var(--do_bg_alt);

    /* The Qt palette, for widgets the stylesheet does not reach. */
    --palette_window: var(--do_bg);
    --palette_windowText: var(--do_fg);
    --palette_base: var(--do_bg_alt);
    --palette_light: var(--do_fg_faint);
    --palette_mid: var(--do_bg_alt);
    --palette_dark: var(--do_surface);
    --palette_highlight: var(--do_accent);
    --palette_highlightedText: var(--do_on_accent);
    --palette_text: var(--do_fg);
    --palette_link: var(--do_accent);
    --palette_linkVisited: var(--do_accent);
    --palette_button: var(--do_surface);
    --palette_buttonText: var(--do_fg);
    --palette_text_active: var(--do_fg);
    --palette_text_disabled: var(--do_fg_faint);
    --palette_text_inactive: var(--do_fg);
}

/* Selected rows carry black text on the accent. */
QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected,
QMenu::item:selected {
    color: var(--do_on_accent);
}

/* The audio meters ride the purple ramp from quiet to loud, and the unlit part
 * of every zone is the border grey. */
VolumeMeter {
    qproperty-backgroundNominalColor: var(--do_border);
    qproperty-backgroundWarningColor: var(--do_border);
    qproperty-backgroundErrorColor: var(--do_border);
    qproperty-foregroundNominalColor: var(--do_accent_dim);
    qproperty-foregroundWarningColor: var(--do_accent_lit);
    qproperty-foregroundErrorColor: var(--do_accent_peak);
    qproperty-magnitudeColor: var(--do_on_accent);
    qproperty-majorTickColor: var(--do_fg_muted);
    qproperty-minorTickColor: var(--do_border);

    qproperty-backgroundNominalColorDisabled: var(--do_bg_alt);
    qproperty-backgroundWarningColorDisabled: var(--do_bg_alt);
    qproperty-backgroundErrorColorDisabled: var(--do_bg_alt);
    qproperty-foregroundNominalColorDisabled: var(--do_fg_faint);
    qproperty-foregroundWarningColorDisabled: var(--do_fg_faint);
    qproperty-foregroundErrorColorDisabled: var(--do_fg_faint);
}
