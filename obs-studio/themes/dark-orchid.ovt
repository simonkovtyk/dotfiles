    --do_zinc_700: #3f3f46; /* border, selection-muted */
    --do_zinc_800: #27272a; /* surface */
    --do_zinc_900: #18181b; /* bg-alt, on-cursor */
    --do_zinc_950: #09090b; /* bg */

    --do_neutral_50: #fafafa; /* neutral-50 */
    --do_neutral_100: #f5f5f5; /* neutral-100 */
    --do_neutral_200: #e5e5e5; /* neutral-200 */
    --do_neutral_300: #d4d4d4; /* neutral-300 */
