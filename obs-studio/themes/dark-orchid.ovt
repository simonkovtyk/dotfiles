@OBSThemeMeta {
    name: 'Dark Orchid';
    id: 'dev.darkorchid.obs';
    extends: 'com.obsproject.Yami';
    author: 'The Dark Orchid Maintainers';
    dark: 'true';
}

/*
 * Dark Orchid — an OBS Studio theme
 *
 * Copyright (c) 2026 — present by The Dark Orchid Maintainers
 * Released under the MIT License — see LICENSE at the repository root.
 */

@OBSThemeVars {
    /* : The palette — every color that exists, named after its ramp and stop */

    --do_white: #ffffff; /* white */
    --do_black: #000000; /* on-accent */

    --do_brand_50: #f1e6ff; /* brand-50 */
    --do_brand_100: #e3ccff; /* brand-100 */
    --do_brand_200: #c799ff; /* accent-peak */
    --do_brand_300: #ab66ff; /* depth-1 */
    --do_brand_400: #8f33ff; /* accent-lit */
    --do_brand_500: #7300ff; /* accent */
    --do_brand_600: #5c00cc; /* accent-dim */
    --do_brand_700: #450099; /* brand-700 */
    --do_brand_800: #2e0066; /* accent-surface */
    --do_brand_900: #170033; /* brand-900 */
    --do_brand_950: #0c001a; /* bg-tinted */

    --do_slate_50: #f8fafc; /* slate-50 */
    --do_slate_100: #f1f5f9; /* slate-100 */
    --do_slate_200: #e2e8f0; /* slate-200 */
    --do_slate_300: #cbd5e1; /* slate-300 */
    --do_slate_400: #94a3b8; /* slate-400 */
