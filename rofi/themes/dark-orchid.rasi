/* THE PALETTE
 *
 * Every colour that exists, named after its ramp and its stop. Nothing outside
 * this block belongs in a rofi theme: no blended shade, no hue of its own. A
 * rasi identifier takes letters, numbers and `-`, so every name here is
 * spelled exactly the way the family spells it. Reach for a stop directly only
 * where no name in the next block fits the job — the comment on a stop says
 * which of those names it carries, and a stop that carries none is a stop with
 * no job yet.
 */
* {
    white:              #ffffff;
    black:              #000000;           /* on-accent */

    brand-50:           #f1e6ff;
    brand-100:          #e3ccff;
    brand-200:          #c799ff;           /* accent-peak */
    brand-300:          #ab66ff;           /* depth-1 */
    brand-400:          #8f33ff;           /* accent-lit */
    brand-500:          #7300ff;           /* accent */
    brand-600:          #5c00cc;           /* accent-dim */
    brand-700:          #450099;
    brand-800:          #2e0066;           /* accent-surface */
    brand-900:          #170033;
    brand-950:          #0c001a;           /* bg-tinted */

    slate-50:           #f8fafc;
    slate-100:          #f1f5f9;
    slate-200:          #e2e8f0;
    slate-300:          #cbd5e1;
    slate-400:          #94a3b8;
    slate-500:          #64748b;
    slate-600:          #475569;
    slate-700:          #334155;
    slate-800:          #1e293b;
    slate-900:          #0f172a;
    slate-950:          #020617;

    gray-50:            #f9fafb;
    gray-100:           #f3f4f6;
    gray-200:           #e5e7eb;
    gray-300:           #d1d5db;
    gray-400:           #9ca3af;
    gray-500:           #6b7280;
    gray-600:           #4b5563;
    gray-700:           #374151;
    gray-800:           #1f2937;
    gray-900:           #111827;
    gray-950:           #030712;

    zinc-50:            #fafafa;
    zinc-100:           #f4f4f5;           /* fg-strong */
    zinc-200:           #e4e4e7;
    zinc-300:           #d4d4d8;           /* fg, syn-text */
    zinc-400:           #a1a1aa;
    zinc-500:           #71717a;           /* fg-muted, hint, syn-comment */
    zinc-600:           #52525b;           /* fg-faint */
    zinc-700:           #3f3f46;           /* border, selection-muted */
    zinc-800:           #27272a;           /* surface */
    zinc-900:           #18181b;           /* bg-alt, on-cursor */
