    --do_stone_700: #44403c; /* stone-700 */
    --do_stone_800: #292524; /* stone-800 */
    --do_stone_900: #1c1917; /* stone-900 */
    --do_stone_950: #0c0a09; /* stone-950 */

    --do_red_50: #fef2f2; /* red-50 */
