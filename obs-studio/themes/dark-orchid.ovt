    --do_emerald_50: #ecfdf5; /* emerald-50 */
    --do_emerald_100: #d1fae5; /* emerald-100 */
    --do_emerald_200: #a7f3d0; /* emerald-200 */
    --do_emerald_300: #6ee7b7; /* emerald-300 */
    --do_emerald_400: #34d399; /* emerald-400 */
    --do_emerald_500: #10b981; /* emerald-500 */
    --do_emerald_600: #059669; /* emerald-600 */
    --do_emerald_700: #047857; /* emerald-700 */
    --do_emerald_800: #065f46; /* emerald-800 */
    --do_emerald_900: #064e3b; /* emerald-900 */
    --do_emerald_950: #022c22; /* emerald-950 */

    --do_teal_50: #f0fdfa; /* teal-50 */
    --do_teal_100: #ccfbf1; /* teal-100 */
    --do_teal_200: #99f6e4; /* teal-200 */
    --do_teal_300: #5eead4; /* teal-300 */
